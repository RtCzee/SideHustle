#port for the server to be running on
PORT=3000

# Firebase Admin — local: path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Firebase Admin — Railway/hosted: paste full JSON as one variable (do not commit)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# PostgreSQL — local example (change user/password/db to match your machine)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sidehustle
