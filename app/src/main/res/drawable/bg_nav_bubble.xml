<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted clear-glass circle behind the active tab icon -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/nav_bubble_glass_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/nav_bar_glass_stroke" />
        </shape>
    </item>
</layer-list>
