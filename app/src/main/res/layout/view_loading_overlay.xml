<?xml version="1.0" encoding="utf-8"?>
<!--
    Blocking overlay (optional): dims the screen and swallows touches while a short, critical
    action runs (e.g. creating an invoice). Drive it with BlockingLoadingOverlay.

    Place it as the LAST child of a FrameLayout so it sits on top of everything.
    Back is NOT blocked unless show(...) is given an onCancel, in which case a Cancel button
    appears and Back cancels the action.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loading_scrim"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:minWidth="220dp"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/overlay_indicator"
                style="@style/Widget.SideHustle.CircularProgressIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                app:indicatorSize="40dp" />

            <TextView
                android:id="@+id/overlay_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/loading_please_wait"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/on_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overlay_cancel_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_cancel"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
