<?xml version="1.0" encoding="utf-8"?>
<!--
    Screen loading: a centred spinner + message. Use for the FIRST load of a screen
    (dashboard metrics, opening a detail screen).

    Include it as a sibling of your content inside a FrameLayout and hand both to
    LoadingStateHandler.forViews(...). It starts hidden; the handler shows it.
    Change the text at runtime with binding.loading.loadingMessage.setText(...).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loading_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- The visible message is what a screen reader announces, so the spinner stays silent. -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading_indicator"
            style="@style/Widget.SideHustle.CircularProgressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/loading_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/loading_default"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_background" />
    </LinearLayout>
</FrameLayout>
