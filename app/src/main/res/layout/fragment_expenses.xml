<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expenses_add_title"
            android:textColor="@color/dashboard_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/amount_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/expenses_amount_hint"
            android:inputType="numberDecimal"
            android:maxLength="13" />

        <EditText
            android:id="@+id/date_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:hint="@string/expenses_date_hint"
            android:inputType="none" />

        <Spinner
            android:id="@+id/category_input"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/description_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/expenses_description_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="255"
            android:minLines="2" />

        <Button
            android:id="@+id/save_expense_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/expenses_save" />

        <ProgressBar
            android:id="@+id/expenses_loading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/expenses_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/cyan_dark"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/expenses_list_title"
            android:textColor="@color/dashboard_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/expenses_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/expenses_empty"
            android:textColor="@color/dashboard_text_muted" />

        <LinearLayout
            android:id="@+id/expenses_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
