<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/background" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/nav_finances" android:textAppearance="?attr/textAppearanceHeadlineMedium" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/invoices_tab"
                style="@style/Widget.SideHustle.FinanceTab" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/invoices_title" />
            <com.google.android.material.button.MaterialButton android:id="@+id/expenses_tab"
                style="@style/Widget.SideHustle.FinanceTab" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/expenses_title" />
            <com.google.android.material.button.MaterialButton android:id="@+id/income_tab"
                style="@style/Widget.SideHustle.FinanceTab" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/income_title" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/toggle_form"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/action_new_invoice" />
        <LinearLayout android:id="@+id/entry_form" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_dashboard_metric_card" android:padding="16dp" android:visibility="gone">
            <com.example.sidehustle.ui.common.list.ListStateView android:id="@+id/options_state"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/invoice_create_title" android:textColor="@color/dashboard_text" android:textSize="22sp" android:textStyle="bold" xmlns:android="http://schemas.android.com/apk/res/android" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/invoice_client_label" android:textStyle="bold" xmlns:android="http://schemas.android.com/apk/res/android" />
<Spinner android:id="@+id/invoice_client" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" xmlns:android="http://schemas.android.com/apk/res/android" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/invoice_job_label" android:textStyle="bold" xmlns:android="http://schemas.android.com/apk/res/android" />
<Spinner android:id="@+id/invoice_job" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" xmlns:android="http://schemas.android.com/apk/res/android" />
<TextView android:id="@+id/invoice_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:text="@string/invoice_total_placeholder" android:textColor="@color/cyan_dark" android:textSize="18sp" android:textStyle="bold" xmlns:android="http://schemas.android.com/apk/res/android" />
<com.google.android.material.button.MaterialButton android:id="@+id/create_invoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/invoice_create_action" xmlns:android="http://schemas.android.com/apk/res/android" />
<TextView android:id="@+id/invoice_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/cyan_dark" android:visibility="gone" xmlns:android="http://schemas.android.com/apk/res/android" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/invoice_list_title"
            android:textAppearance="?attr/textAppearanceTitleLarge" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refresh_list"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/action_refresh" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/list_refreshing"
            style="@style/Widget.SideHustle.LinearProgressIndicator" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
        <com.example.sidehustle.ui.common.list.ListStateView android:id="@+id/list_state"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/invoice_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
    </LinearLayout>
</ScrollView>