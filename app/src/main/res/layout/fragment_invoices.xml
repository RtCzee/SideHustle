<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/invoices_tab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="@string/invoices_title" />
            <Button android:id="@+id/expenses_tab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/expenses_title" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/invoice_create_title" android:textColor="@color/dashboard_text" android:textSize="22sp" android:textStyle="bold" />

        <Spinner
            android:id="@+id/invoice_client"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/invoice_job"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/invoice_total"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="@string/invoice_total_placeholder"
            android:textColor="@color/cyan_dark"
            android:textSize="18sp"
            android:textStyle="bold" />
        <Button android:id="@+id/create_invoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/invoice_create_action" />
        <TextView android:id="@+id/invoice_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/cyan_dark" android:visibility="gone" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/invoice_list_title" android:textColor="@color/dashboard_text" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/invoice_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
