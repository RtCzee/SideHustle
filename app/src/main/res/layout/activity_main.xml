<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- Glass curved nav — hidden on auth/detail screens via MainActivity -->
    <com.example.sidehustle.ui.navigation.CurvedBottomNavBar
        android:id="@+id/floating_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/curved_nav_total_height"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/curved_nav_margin_horizontal"
        android:layout_marginBottom="@dimen/curved_nav_margin_bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone" />

</FrameLayout>
