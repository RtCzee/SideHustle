<?xml version="1.0" encoding="utf-8"?>
<!--
    List skeleton / shimmer: placeholder rows for lists with several items (clients, projects,
    invoices). Use for the FIRST load of a list; use pull-to-refresh for later refreshes.

    Include it over the list inside a FrameLayout and hand it to LoadingStateHandler.forViews(...).
    It starts hidden. The shimmer only animates while the view is on screen.
-->
<com.example.sidehustle.ui.common.loading.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_loading_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:contentDescription="@string/cd_loading_list"
    android:importantForAccessibility="yes"
    android:accessibilityLiveRegion="polite"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/item_skeleton_row" />
        <include layout="@layout/item_skeleton_row" />
        <include layout="@layout/item_skeleton_row" />
        <include layout="@layout/item_skeleton_row" />
        <include layout="@layout/item_skeleton_row" />
        <include layout="@layout/item_skeleton_row" />
        <include layout="@layout/item_skeleton_row" />
        <include layout="@layout/item_skeleton_row" />
    </LinearLayout>
</com.example.sidehustle.ui.common.loading.ShimmerFrameLayout>
